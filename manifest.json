{
  "manifest_version": 3,
  "name": "Git Platform Enhancer",
  "version": "1.0.0",
  "description": "Modular Menu",
  "icons": { "128": "icon.png" },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["*://github.com/*"],
      "js": [
        "github/platform.js",
        "shared/ui.js",
        "shared/storage.js",
        "shared/core.js",
        "shared/buttons.js",
        "shared/favorites.js",
        "shared/bootstrap.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://gitlab.com/*"],
      "js": [
        "gitlab/platform.js",
        "shared/ui.js",
        "shared/storage.js",
        "shared/core.js",
        "shared/buttons.js",
        "shared/favorites.js",
        "shared/bootstrap.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
